{
  "name": "@purea/utils",
  "type": "module",
  "version": "0.2.0",
  "packageManager": "pnpm@10.33.2",
  "description": "小而美的 TypeScript 异步工具：可取消执行、并发去重、类型安全事件、稳定序列化，以及开箱即用的 uni-app 请求封装",
  "author": "Pure Anin <pureanin@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pureia/utils.git"
  },
  "keywords": [
    "utils",
    "typescript",
    "async",
    "cancel",
    "dedupe",
    "uni-app",
    "fetch"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core/index.d.mts",
      "import": "./dist/core/index.mjs"
    },
    "./core/createAsyncDedupe": {
      "types": "./dist/core/createAsyncDedupe.d.mts",
      "import": "./dist/core/createAsyncDedupe.mjs"
    },
    "./core/createCancelable": {
      "types": "./dist/core/createCancelable.d.mts",
      "import": "./dist/core/createCancelable.mjs"
    },
    "./core/createEventEmitter": {
      "types": "./dist/core/createEventEmitter.d.mts",
      "import": "./dist/core/createEventEmitter.mjs"
    },
    "./core/stableStringify": {
      "types": "./dist/core/stableStringify.d.mts",
      "import": "./dist/core/stableStringify.mjs"
    },
    "./package.json": "./package.json",
    "./uniapp": {
      "types": "./dist/uniapp/index.d.mts",
      "import": "./dist/uniapp/index.mjs"
    },
    "./uniapp/createFetch": {
      "types": "./dist/uniapp/createFetch.d.mts",
      "import": "./dist/uniapp/createFetch.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@dcloudio/types": "^3.4.31",
    "@purea/eslint-config": "^0.0.6",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "jiti": "^2.6.1",
    "publint": "^0.3.23",
    "tsdown": "^0.22.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
