{
  "name": "@purea/utils",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.27.0",
  "description": "Pure Anin Utils",
  "keywords": [
    "utils"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core/index.d.mts",
      "import": "./dist/core/index.mjs"
    },
    "./core/*": {
      "types": "./dist/core/*.d.mts",
      "import": "./dist/core/*.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@purea/eslint-config": "latest",
    "eslint": "^9.39.2",
    "jiti": "^2.6.1",
    "tsdown": "^0.21.9",
    "typescript": "^5.7.3",
    "vitest": "^4.1.4"
  }
}
