{
  "compilerOptions": {
    "target": "ESNext",
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@dcloudio/types"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@purea/utils": ["./src/index.ts"],
      "@purea/utils/lodash": ["./src/third-party/lodash.ts"]
    }
  },
  "include": ["**/*.ts"]
}
